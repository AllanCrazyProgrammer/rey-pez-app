rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Rey Pez usa un login propio en el cliente, no Firebase Auth.
    // Se conserva el mismo modelo de acceso que Firestore en este proyecto.
    match /bitacoras/{entryId}/{fileName} {
      allow read, delete: if true;
      allow create, update: if request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /journal/{entryId}/{fileName} {
      allow read, write: if true;
    }
  }
}
