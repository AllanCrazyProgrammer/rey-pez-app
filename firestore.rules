rules_version = '2';
// PROPUESTA (no desplegada). Fase 1: solo usuarios con sesión de Firebase Auth.
// Desplegar únicamente después de seguir docs/SEGURIDAD_Y_RESPALDOS.md
// (cuentas creadas, TODAS las instalaciones web/escritorio/Android actualizadas).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
