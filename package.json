{
  "name": "rey-pez",
  "version": "0.3.22",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "vue-cli-service serve",
    "build:web": "vue-cli-service build",
    "deploy:web": "npm run build:web && firebase deploy --only hosting",
    "deploy:web:preview": "npm run build:web && firebase hosting:channel:deploy preview --expires 7d",
    "build": "vue-cli-service build && npx cap sync",
    "test:maria": "node --test scripts/test-maria.cjs",
    "test:embarques-offline": "node scripts/test-embarques-offline.cjs",
    "test:embarques-historial": "node --test scripts/test-embarques-historial.cjs",
    "test:embarques-colaboracion": "node --test scripts/test-embarques-colaboracion.cjs",
    "lint": "eslint --ext .js,.vue src",
    "electron:dev": "node scripts/dev-desktop.cjs",
    "electron:build": "node scripts/build-desktop.cjs",
    "electron:assets": "node scripts/build-desktop.cjs --assets-only",
    "electron:mac": "node scripts/build-desktop.cjs --mac --arm64",
    "electron:win": "node scripts/build-desktop.cjs --win --x64",
    "electron:local": "electron electron/main.js",
    "test:desktop-offline": "node scripts/test-desktop-offline.cjs",
    "test:desktop-print": "node scripts/test-desktop-print.cjs",
    "test:embarques-transfer": "node scripts/test-embarques-transfer.cjs",
    "test:drive-notas": "node --test scripts/test-drive-notas.cjs scripts/test-resumen-backup.cjs scripts/test-reportes-backup.cjs scripts/test-rendimientos-report.cjs",
    "build:android:web": "node scripts/build-android.cjs --solo-web",
    "build:actualizaciones": "npm run build:web && node scripts/build-desktop.cjs --assets-only && node scripts/build-android.cjs --solo-web && node scripts/publicar-actualizaciones.cjs",
    "android:sync": "VUE_APP_TARGET=android cap sync android",
    "android:open": "VUE_APP_TARGET=android cap open android",
    "android:apk": "node scripts/build-android.cjs",
    "android:apk:release": "node scripts/build-android.cjs --release",
    "test:android:inventarios": "node scripts/test-inventarios-android.cjs",
    "test:android:arranque": "node scripts/test-android-arranque.cjs",
    "test:sacadas:dias": "node scripts/test-sacadas-dias.cjs",
    "test:deudas": "node --test scripts/test-deudas-saldo.cjs",
    "test:embarques-presencia": "node --test scripts/test-embarques-presencia.cjs",
    "test:embarques-presencia-rtdb": "node --test scripts/test-embarques-presencia-rtdb.cjs",
    "test:embarques-pesadas": "node --test scripts/test-embarques-pesadas.cjs",
    "test:embarques-movil": "node --test scripts/test-embarques-movil.cjs",
    "test:reglas": "firebase emulators:exec --config seguridad/firebase.emulador.json --project demo-reypez --only firestore,database,storage \"node --test scripts/test-reglas-propuesta.cjs\""
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^6.0.1",
    "@capacitor/android": "6.2.3",
    "@capacitor/app": "6.0.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/ios": "^6.2.3",
    "@capgo/capacitor-updater": "6.53.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/roboto": "^5.1.0",
    "@fontsource/sail": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "bootstrap": "^5.0.0",
    "bootstrap-vue": "^2.21.2",
    "chart.js": "^3.9.1",
    "core-js": "^3.6.5",
    "firebase": "^10.14.1",
    "html2pdf.js": "0.14.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "moment": "^2.30.1",
    "nanoid": "^3.3.4",
    "pdfjs-dist": "^4.10.38",
    "pdfmake": "^0.2.18",
    "pinia": "^2.3.0",
    "uuid": "^11.1.1",
    "vue": "^2.6.11",
    "vue-router": "^3.5.2",
    "vue2-datepicker": "^3.11.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-optional-chaining": "^7.25.9",
    "@capacitor/cli": "^6.2.3",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@vue/cli-plugin-babel": "~5.0.9",
    "@vue/cli-service": "~5.0.9",
    "babel-eslint": "^10.1.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^7.20.0",
    "fake-indexeddb": "^6.2.5",
    "fflate": "0.8.3",
    "firebase-tools": "^15.33.0",
    "jsdom": "^20.0.3",
    "playwright": "^1.63.0",
    "vue-template-compiler": "^2.6.11",
    "wait-on": "^9.0.3"
  },
  "engines": {
    "node": "20.15.0"
  },
  "build": {
    "appId": "com.reypez.desktop",
    "productName": "ReyPez",
    "directories": {
      "output": "release/offline-0.3.20"
    },
    "files": [
      "desktop-dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "npmRebuild": false,
    "artifactName": "ReyPez-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "beforePack": "scripts/validate-drive-build.cjs"
  },
  "reypez": {
    "minimoInstalador": {
      "escritorio": "0.3.20",
      "android": "0.3.20"
    }
  },
  "description": "Embarques ReyPez con almacenamiento local y sincronización"
}
